# ── Broker ────────────────────────────────────────────────────────────
PORT=8090
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_TTL_HOURS=720

# Llave con la que se cifran los secretos de las integraciones en la base.
# Si la cambias, los secretos guardados dejan de poder descifrarse.
MASTER_KEY=cambia-esta-llave-maestra

# Token para /v1/admin/* (x-admin-token). Vacío = abierto (solo desarrollo).
ADMIN_TOKEN=

# ── Postgres ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://octano:octano@localhost:5432/octano

# ══════════════════════════════════════════════════════════════════════
# MULTI-CLIENTE: los endpoints de Retail Manager y PTS2Link NO se
# configuran aquí. Cada estación trae los suyos en la tabla
# `integrations`, administrados por API:
#
#   POST /v1/admin/tenants           → cliente/operador
#   POST /v1/admin/stations          → estación de ese cliente
#   POST /v1/admin/integrations      → su RM API, su PTS2Link, su PTS-2
#   POST /v1/admin/integrations/:id/test
#   GET  /v1/admin/stations/:id/effective-config
#
# Lo de abajo son SOLO valores por omisión para el primer arranque y para
# la semilla de desarrollo.
# ══════════════════════════════════════════════════════════════════════

RM_API_BASE=http://localhost:8180
RM_API_USER_ID=2
RM_API_USER_PASS=abc123
RM_API_CHANNEL=1
RM_API_TIMEOUT_MS=8000
RM_FUEL_MOP=CREDIT

PTS2LINK_BASE=http://localhost:9080
PTS2LINK_WS=ws://localhost:9080/ws
PTS2LINK_TOKEN=

PTS_DIRECT_ENABLED=false

# ── Reglas por omisión (cada estación puede sobreescribirlas) ─────────
HOLD_TTL_MINUTES=60
MAX_AUTH_AMOUNT=200
PUMP_POLL_MS=1500
OUTBOX_POLL_MS=3000
